generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchState {
  CREATED
  OPEN
  FULL
  TEAM_SETUP
  TEAMS_LOCKED
  SERVER_PROVISIONING
  SERVER_BOOTING
  SERVER_READY
  MATCH_LOADED
  WARMUP
  LIVE
  PAUSED
  FINISHED
  CANCELED
  FAILED
}

enum CleanupStatus {
  NOT_REQUIRED
  PENDING
  RUNNING
  RETRY
  COMPLETE
  FAILED
}

enum PlayerTeam {
  UNASSIGNED
  TEAM_1
  TEAM_2
  SPECTATOR
}

enum ParticipantRole {
  PLAYER
  SPECTATOR
}

enum ReadyState {
  NOT_READY
  READY
  WAITING_FOR_VOICE
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETE
  FAILED
}

enum ProvisioningStatus {
  DUPLICATE_REQUEST_PENDING
  DUPLICATE_OUTCOME_UNKNOWN
  SERVER_IDENTIFIED
  AMBIGUOUS
  COMPLETE
  FAILED
}

enum CredentialCapability {
  CONFIG_READ
  EVENT_WRITE
}

model User {
  discordUserId   String          @id @map("discord_user_id")
  displayName     String          @map("display_name")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  steamIdentities SteamIdentity[]
  matchPlayers    MatchPlayer[]

  @@map("users")
}

model SteamIdentity {
  id                 String    @id @default(uuid()) @db.Uuid
  discordUserId      String    @map("discord_user_id")
  steamId64          String    @map("steam_id_64")
  verifiedAt         DateTime  @map("verified_at")
  invalidatedAt      DateTime? @map("invalidated_at")
  invalidationReason String?   @map("invalidation_reason")
  provenance         String
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User      @relation(fields: [discordUserId], references: [discordUserId])

  @@index([discordUserId])
  @@index([steamId64])
  @@map("steam_identities")
}

model SteamLinkSession {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  discordUserId     String    @map("discord_user_id")
  expectedReturnUrl String    @map("expected_return_url")
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([discordUserId, expiresAt])
  @@map("steam_link_sessions")
}

model GuildSettings {
  guildId                 String   @id @map("guild_id")
  lobbyTextChannelId      String?  @map("lobby_text_channel_id")
  lobbyVoiceChannelId     String?  @map("lobby_voice_channel_id")
  team1VoiceChannelId     String?  @map("team1_voice_channel_id")
  team2VoiceChannelId     String?  @map("team2_voice_channel_id")
  privilegedRoleIds       String[] @map("privileged_role_ids")
  moderatorRoleIds        String[] @map("moderator_role_ids")
  administratorRoleIds    String[] @map("administrator_role_ids")
  dathostTemplateServerId String?  @map("dathost_template_server_id")
  defaultServerLocation   String?  @map("default_server_location")
  defaultGameProfileKey   String?  @map("default_game_profile_key")
  enabled                  Boolean  @default(false)
  version                  Int      @default(0)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  matches                  Match[]

  @@map("guild_settings")
}

model GameProfile {
  key             String   @id
  enabled         Boolean  @default(false)
  playersPerTeam  Int      @map("players_per_team")
  numMaps         Int      @default(1) @map("num_maps")
  serverSlots     Int      @map("server_slots")
  mapAllowlist    String[] @map("map_allowlist")
  matchzyOptions  Json     @map("matchzy_options")
  allowedCvars    Json     @map("allowed_cvars")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  matches          Match[]

  @@map("game_profiles")
}

model Match {
  id                       String                @id @default(uuid()) @db.Uuid
  guildId                  String                @map("guild_id")
  leaderDiscordUserId      String                @map("leader_discord_user_id")
  state                    MatchState            @default(CREATED)
  cleanupStatus            CleanupStatus         @default(NOT_REQUIRED) @map("cleanup_status")
  guildSlotActive          Boolean               @default(true) @map("guild_slot_active")
  selectedMap              String?               @map("selected_map")
  selectedGameProfileKey   String                @map("selected_game_profile_key")
  dathostServerId          String?               @unique @map("dathost_server_id")
  dathostIp                String?               @map("dathost_ip")
  dathostPort              Int?                  @map("dathost_port")
  encryptedRconPassword    String?               @map("encrypted_rcon_password")
  encryptedJoinPassword    String?               @map("encrypted_join_password")
  matchzyMatchId           Int                   @unique @default(autoincrement()) @map("matchzy_match_id")
  matchzyConfig            Json?                 @map("matchzy_config")
  matchzyConfigHash        String?               @map("matchzy_config_hash")
  lastMatchzyEventAt       DateTime?             @map("last_matchzy_event_at")
  discordPanelChannelId    String?               @map("discord_panel_channel_id")
  discordPanelMessageId    String?               @map("discord_panel_message_id")
  result                   Json?
  score                    Json?
  failureReason            String?               @map("failure_reason")
  version                  Int                   @default(0)
  createdAt                DateTime              @default(now()) @map("created_at")
  startedAt                DateTime?             @map("started_at")
  finishedAt               DateTime?             @map("finished_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  guild                    GuildSettings         @relation(fields: [guildId], references: [guildId])
  profile                  GameProfile           @relation(fields: [selectedGameProfileKey], references: [key])
  players                  MatchPlayer[]
  transitions              MatchStateTransition[]
  cleanupTransitions       CleanupTransition[]
  auditEvents              AuditEvent[]
  externalEvents           ExternalEvent[]
  reconciliationEvents     ReconciliationEvent[]
  provisioningAttempts     ProvisioningAttempt[]
  jobs                     Job[]
  demoReferences           DemoReference[]
  credentials              MatchCredential[]

  @@index([guildId, state])
  @@index([state, lastMatchzyEventAt])
  @@map("matches")
}

model MatchPlayer {
  id                  String          @id @default(uuid()) @db.Uuid
  matchId             String          @map("match_id") @db.Uuid
  discordUserId       String          @map("discord_user_id")
  steamId64           String          @map("steam_id_64")
  displayNameSnapshot String          @map("display_name_snapshot")
  participantRole     ParticipantRole @default(PLAYER) @map("participant_role")
  team                PlayerTeam      @default(UNASSIGNED)
  readyState          ReadyState      @default(NOT_READY) @map("ready_state")
  joinedAt            DateTime        @default(now()) @map("joined_at")
  match               Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([matchId, discordUserId])
  @@unique([matchId, steamId64])
  @@index([matchId, team])
  @@map("match_players")
}

model MatchStateTransition {
  id        String     @id @default(uuid()) @db.Uuid
  matchId   String     @map("match_id") @db.Uuid
  fromState MatchState @map("from_state")
  toState   MatchState @map("to_state")
  source    String
  reason    String?
  eventId   String?    @map("event_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("match_state_transitions")
}

model CleanupTransition {
  id         String        @id @default(uuid()) @db.Uuid
  matchId    String        @map("match_id") @db.Uuid
  fromStatus CleanupStatus @map("from_status")
  toStatus   CleanupStatus @map("to_status")
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at")
  match      Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("cleanup_transitions")
}

model AuditEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  matchId              String?  @map("match_id") @db.Uuid
  guildId              String   @map("guild_id")
  actorDiscordUserId   String?  @map("actor_discord_user_id")
  eventType            String   @map("event_type")
  result               String
  correlationId        String   @map("correlation_id")
  metadata             Json
  createdAt            DateTime @default(now()) @map("created_at")
  match                Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([matchId, createdAt])
  @@map("audit_events")
}

model ExternalEvent {
  id             String    @id @default(uuid()) @db.Uuid
  matchId        String    @map("match_id") @db.Uuid
  provider       String
  eventType      String    @map("event_type")
  dedupeKey      String    @map("dedupe_key")
  payload        Json
  payloadHash    String    @map("payload_hash")
  processedAt    DateTime? @map("processed_at")
  processingError String?  @map("processing_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, provider, dedupeKey])
  @@index([matchId, createdAt])
  @@map("external_events")
}

model ReconciliationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  observation Json
  correction  Json?
  result      String
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("reconciliation_events")
}

model ProvisioningAttempt {
  id                   String             @id @default(uuid()) @db.Uuid
  matchId              String             @map("match_id") @db.Uuid
  status               ProvisioningStatus
  provisionalName      String             @unique @map("provisional_name")
  requestedTemplateId  String             @map("requested_template_id")
  requestedLocation    String             @map("requested_location")
  requestStartedAt     DateTime?          @map("request_started_at")
  requestFinishedAt    DateTime?          @map("request_finished_at")
  dathostServerId      String?            @map("dathost_server_id")
  candidateEvidence    Json?              @map("candidate_evidence")
  operatorResolution   Json?              @map("operator_resolution")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  match                Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, status])
  @@map("provisioning_attempts")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  matchId     String?   @map("match_id") @db.Uuid
  type        String
  status      JobStatus @default(PENDING)
  idempotencyKey String @unique @map("idempotency_key")
  payload     Json
  attempts    Int       @default(0)
  runAt       DateTime  @default(now()) @map("run_at")
  leaseOwner  String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  match       Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("jobs")
}

model MatchCredential {
  id         String               @id @default(uuid()) @db.Uuid
  matchId    String               @map("match_id") @db.Uuid
  capability CredentialCapability
  tokenHash  String               @unique @map("token_hash")
  serverId   String?              @map("server_id")
  version    Int                  @default(1)
  expiresAt  DateTime             @map("expires_at")
  revokedAt  DateTime?            @map("revoked_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  match      Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, capability, version])
  @@index([matchId, capability, expiresAt])
  @@map("match_credentials")
}

model DemoReference {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  mapName   String   @map("map_name")
  status    String
  reference String?
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, mapName])
  @@map("demo_references")
}
